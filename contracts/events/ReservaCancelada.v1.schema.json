{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://locafacil.example/contracts/events/ReservaCancelada.v1.schema.json",
  "title": "ReservaCancelada v1",
  "description": "Reservas -> Frota (compensação: libera o veículo), Notificações.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "reservaId": {
      "type": "string",
      "format": "uuid"
    },
    "clienteId": {
      "type": "string",
      "minLength": 1
    },
    "clienteEmail": {
      "type": "string",
      "format": "email"
    },
    "filial": {
      "type": "string",
      "minLength": 2,
      "maxLength": 10
    },
    "categoria": {
      "type": "string",
      "enum": [
        "HATCH",
        "SEDAN",
        "SUV"
      ]
    },
    "dataInicio": {
      "type": "string",
      "format": "date"
    },
    "dataFim": {
      "type": "string",
      "format": "date"
    },
    "motivo": {
      "type": "string",
      "enum": [
        "SEM_DISPONIBILIDADE",
        "PAGAMENTO_RECUSADO",
        "TIMEOUT_PAGAMENTO"
      ]
    }
  },
  "required": [
    "reservaId",
    "clienteId",
    "filial",
    "categoria",
    "dataInicio",
    "dataFim",
    "motivo"
  ]
}