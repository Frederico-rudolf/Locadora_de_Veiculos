{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://locafacil.example/contracts/events/ReservaSolicitada.v1.schema.json",
  "title": "ReservaSolicitada v1",
  "description": "Reservas -> Frota. Pede o bloqueio de uma unidade da categoria em cada dia do período.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "reservaId": {
      "type": "string",
      "format": "uuid"
    },
    "clienteId": {
      "type": "string",
      "minLength": 1
    },
    "clienteEmail": {
      "type": "string",
      "format": "email"
    },
    "filial": {
      "type": "string",
      "minLength": 2,
      "maxLength": 10
    },
    "categoria": {
      "type": "string",
      "enum": [
        "HATCH",
        "SEDAN",
        "SUV"
      ]
    },
    "dataInicio": {
      "type": "string",
      "format": "date"
    },
    "dataFim": {
      "type": "string",
      "format": "date"
    },
    "valorTotal": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "reservaId",
    "clienteId",
    "filial",
    "categoria",
    "dataInicio",
    "dataFim",
    "valorTotal"
  ]
}